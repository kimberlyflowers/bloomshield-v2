# ThirdWeb Blockchain Configuration
# Required for real blockchain timestamping on Base network (Coinbase L2)
# Base is 90% cheaper than Polygon: $0.0005 vs $0.005 per transaction
# If not configured, the app will fall back to simulated blockchain transactions (0xSIM...)

# ThirdWeb Private Key - DO NOT commit this to git!
# Get this from ThirdWeb dashboard: https://thirdweb.com/dashboard
THIRDWEB_PRIVATE_KEY=your_private_key_here

# ThirdWeb Client ID (public)
# Get this from ThirdWeb dashboard
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_client_id_here

# ThirdWeb Secret Key - DO NOT commit this to git!
# Get this from ThirdWeb dashboard
THIRDWEB_SECRET_KEY=your_secret_key_here

# Smart Contract Address on Base network
# This is the address of your deployed timestamping contract on Base
# Deploy via: https://thirdweb.com/dashboard → Deploy → Select "Base" network
THIRDWEB_CONTRACT_ADDRESS=0x_your_contract_address_here

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (for admin operations)
# IMPORTANT: Keep this secret! Only use on server-side
# Used for: Revenue tracking, gas wallet management
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe Configuration (for automated gas wallet funding)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret (for webhook signature verification)
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Setup Instructions:
# 1. Copy this file to .env.local
# 2. Replace all values with your actual credentials
# 3. Never commit .env.local to git (it's already in .gitignore)
# 4. For Vercel deployment, add these to Environment Variables in project settings
