# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ThirdWeb Configuration (Polygon Blockchain)
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your-thirdweb-client-id
THIRDWEB_SECRET_KEY=your-thirdweb-secret-key
THIRDWEB_PRIVATE_KEY=your-wallet-private-key
THIRDWEB_CONTRACT_ADDRESS=your-deployed-contract-address

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace all values with your actual credentials
# 3. Never commit .env.local to git (it's in .gitignore)
#
# Get Supabase credentials: https://supabase.com
# Get ThirdWeb credentials: https://thirdweb.com
