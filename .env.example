# ThirdWeb Blockchain Configuration
# Required for real blockchain timestamping on Polygon network
# If not configured, the app will fall back to simulated blockchain transactions (0xSIM...)

# ThirdWeb Private Key - DO NOT commit this to git!
# Get this from ThirdWeb dashboard: https://thirdweb.com/dashboard
THIRDWEB_PRIVATE_KEY=your_private_key_here

# ThirdWeb Client ID (public)
# Get this from ThirdWeb dashboard
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_client_id_here

# ThirdWeb Secret Key - DO NOT commit this to git!
# Get this from ThirdWeb dashboard
THIRDWEB_SECRET_KEY=your_secret_key_here

# Smart Contract Address on Polygon network
# This is the address of your deployed timestamping contract
THIRDWEB_CONTRACT_ADDRESS=0x_your_contract_address_here

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Database URL for Better Auth
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# Get from Supabase: Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# App URL (for Better Auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Polar Payment Configuration
# Get these from your Polar dashboard: https://polar.sh/settings
# Polar is used for marketplace payments and payouts
POLAR_ACCESS_TOKEN=your_polar_access_token_here
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here
NEXT_PUBLIC_POLAR_ORGANIZATION_ID=your_polar_organization_id_here

# Setup Instructions:
# 1. Copy this file to .env.local
# 2. Replace all values with your actual credentials
# 3. Never commit .env.local to git (it's already in .gitignore)
# 4. For Vercel deployment, add these to Environment Variables in project settings
